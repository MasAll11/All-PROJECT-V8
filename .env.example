# Copy to .env locally. Never commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/all_project_v8?schema=public"
APP_URL="http://localhost:3000"
# Generate a unique long random secret for each environment. Required to hash privacy-sensitive request metadata.
SESSION_SECRET="replace-with-at-least-32-random-bytes"
# Configure AI credentials only in the server environment / secret manager.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-2.0-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
XAI_API_KEY=""
XAI_MODEL="grok-3-mini-fast"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
GITHUB_TOKEN=""
GITHUB_MODEL="openai/gpt-4o-mini"
